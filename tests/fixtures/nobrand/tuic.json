{
  "schema": 1,
  "name": "synthetic-nobrand-tuic",
  "listener": {
    "host": "::",
    "port": 4433
  },
  "display_endpoint": {
    "host": "public.synthetic.test",
    "port": 7443
  },
  "settings": {
    "tls": {
      "server_name": "tuic.synthetic.test",
      "certificate_file": "/external/synthetic/cert.pem",
      "private_key_file": "/external/synthetic/key.pem",
      "ca_certificate": "EPHEMERAL_CA_REQUIRED"
    },
    "version": 5,
    "congestion_control": "cubic",
    "udp_relay_mode": "native",
    "zero_rtt_handshake": false
  },
  "policy_mode": "metadata_only",
  "users": [
    {
      "account_name": "Alice",
      "traffic_policy": {
        "quota_bytes": 1048576,
        "upload_bps": 1000
      }
    },
    {
      "account_name": "Bob",
      "traffic_policy": {
        "quota_bytes": 2097152,
        "download_bps": 2000
      }
    }
  ]
}
